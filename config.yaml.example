# client-finder configuration
# Copy to config.yaml and fill in your values

llm:
  provider: "openai"        # openai | anthropic | ollama | local
  model: "gpt-4o-mini"
  api_key_env: "OPENAI_API_KEY"
  base_url: null            # set for Ollama/local: http://localhost:11434/v1
  temperature: 0.7
  max_tokens: 1500

outreach:
  mode: "email_only"        # email_only | work_first
  humanize: true            # LLM humanization pass on every message
  dry_run: true             # TRUE by default; flip to false to actually send
  channels: [email, linkedin, twitter, webform]
  max_per_run: 20
  daily_caps:
    email: 20
    linkedin: 5
    twitter: 10
    webform: 10
  send_hours: [9, 10, 11, 14, 15, 16]   # local hours when sending is allowed
  timezone: "UTC"
  email:
    use_browser: true       # true = Playwright browser (Gmail web UI), false = SMTP
    host: "smtp.gmail.com"  # fallback SMTP (only used if use_browser: false)
    port: 587
    from_name: "Slav Hayrapetyan"

session:
  cookies_dir: "state/cookies"
  headless_after_login: true
  login_timeout_seconds: 600
  session_check_timeout_seconds: 10
  novnc:
    enabled: true           # Use noVNC for browser login in Docker
    vnc_port: 5900
    websockify_port: 6080
    novnc_path: "/usr/share/novnc"
    display: ":99"

work_first:
  output_dir: "work/"
  deliverable_types: [mockup, audit, code_sample]
  max_deliverables_per_run: 5

sources:
  github_jobs: true
  google_maps: true
  linkedin: true
  job_boards: true
  respect_robots_txt: true
  rate_limit_seconds: 5

scraping:
  impersonate: "rotate"          # chrome120 | chrome124 | chrome131 | firefox122 | safari17 | safari18 | rotate
  rate_limit_seconds: 5
  timeout_seconds: 30
  max_retries: 3
  respect_robots_txt: true

state:
  db_path: ".client_finder_state.db"