{
  "mcpServers": {
    "client-finder": {
      "command": "python",
      "args": ["mcp/server.py"],
      "cwd": "/path/to/client-finder",
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "SMTP_HOST": "${SMTP_HOST}",
        "SMTP_PORT": "${SMTP_PORT}",
        "SMTP_USER": "${SMTP_USER}",
        "SMTP_PASS": "${SMTP_PASS}",
        "SMTP_FROM": "${SMTP_FROM}",
        "SMTP_FROM_NAME": "${SMTP_FROM_NAME}"
      }
    }
  }
}